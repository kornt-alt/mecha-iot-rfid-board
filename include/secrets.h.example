// คัดลอกเป็น include/secrets.h แล้วใส่ค่าจริง (secrets.h ไม่ขึ้น git)
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// ถ้าเน็ตโรงงานบล็อก NTP ภายนอก ให้ใส่ NTP server ภายใน (เช่น IP ของ domain controller) ที่ NTP_SERVER_1
#define NTP_SERVER_1  "pool.ntp.org"
#define NTP_SERVER_2  "time.google.com"

// MECHA-CHECKIN backend (WebSocket) — SERVER_HOST ว่าง = ไม่ส่งข้อมูล ทำงานออฟไลน์อย่างเดียว
#define SERVER_HOST ""                        // ชื่อเครื่องหรือ IP ไม่ต้องใส่ ws://
#define SERVER_PORT 80                        // production ผ่าน Apache = 80, dev ต่อตรง Node = 5000
#define SERVER_PATH "/MECHA-CHECKIN/device"
#define DEVICE_ID   "ESP-01"                  // ห้ามซ้ำกันระหว่างเครื่อง [A-Za-z0-9_-] ไม่เกิน 32 ตัว
#define DEVICE_KEY  ""                        // ตรงกับ DEVICE_KEY ใน backend/.env
